<Project>
  <PropertyGroup>
    <Product>Tidal Audio Switcher</Product>
    <Company>Tidal Audio Switcher</Company>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <!-- Win32 icon: embed in TidalAudioSwitcher.exe and TidalAudioSwitcher.UI.exe only -->
  <PropertyGroup Condition="'$(OutputType)' == 'WinExe'">
    <ApplicationIcon>$(MSBuildThisFileDirectory)Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WPF window icon (Icon="/Assets/app.ico" in XAML) -->
  <ItemGroup Condition="'$(UseWpf)' == 'true'">
    <Resource Include="$(MSBuildThisFileDirectory)Assets\app.ico">
      <Link>Assets\app.ico</Link>
    </Resource>
  </ItemGroup>
</Project>
