<Window x:Class="TidalAudioSwitcher.Launcher.TidalWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tidal Audio Switcher"
        Icon="/Assets/app.ico"
        Width="360"
        Height="120"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="ToolWindow"
        Background="#1E1E1E"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="14">
    <Border Padding="20">
        <TextBlock x:Name="StatusText"
                   Text="Warte auf TIDAL-Verbindung …"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
    </Border>
</Window>
