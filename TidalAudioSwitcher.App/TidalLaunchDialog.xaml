<Window x:Class="TidalAudioSwitcher.App.TidalLaunchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIDAL-Verbindung"
        Icon="/Assets/app.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="#1E1E1E"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="14"
        MinWidth="420"
        MaxWidth="520">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       LineHeight="20" />

            <TextBlock x:Name="LauncherInfoText"
                       TextWrapping="Wrap"
                       Foreground="#AAAAAA"
                       FontSize="12"
                       Margin="0,0,0,16"
                       LineHeight="18" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="AutoStartButton"
                        Content="Automatisch starten"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="AutoStartButton_Click" />
                <Button x:Name="LauncherButton"
                        Content="Launcher starten"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="LauncherButton_Click" />
                <Button Content="Abbrechen"
                        Padding="14,8"
                        IsCancel="True"
                        Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
