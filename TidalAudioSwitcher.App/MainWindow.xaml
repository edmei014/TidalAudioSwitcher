<Window x:Class="TidalAudioSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidalAudioSwitcher.App"
        Title="Tidal Audio Switcher"
        Icon="/Assets/app.ico"
        Height="210"
        Width="720"
        MinHeight="180"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HeaderCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseChrome"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseChrome" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseChrome" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactRoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Background" Value="#CC222226" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DD2A2A30" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#BB1A1A1E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactMusicButton"
               TargetType="Button"
               BasedOn="{StaticResource CompactRoundButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMusicModeActive}" Value="True">
                    <Setter Property="Background" Value="#CC2D6A4F" />
                    <Setter Property="BorderBrush" Value="#6640966C" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <!-- Expanded -->
        <Grid x:Name="ExpandedRoot"
              Background="#1E1E1E"
              Visibility="{Binding IsCompactView, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#252525">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        Padding="16,8"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="ExpandedDragHeader_MouseLeftButtonDown">
                    <TextBlock Text="Tidal Audio Switcher"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Border>

                <Button Grid.Column="1"
                        Style="{StaticResource HeaderCloseButton}"
                        Content="×"
                        Click="CloseWindow_Click"
                        ToolTip="Schließen" />

                <Border Grid.ColumnSpan="2"
                        VerticalAlignment="Bottom"
                        BorderBrush="#444444"
                        BorderThickness="0,0,0,1"
                        IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="TIDAL Device"
                           VerticalAlignment="Center"
                           Width="110" />
                <ComboBox ItemsSource="{Binding TidalDeviceChoices}"
                          SelectedItem="{Binding SelectedTidalDevice}"
                          DisplayMemberPath="FriendlyName"
                          Width="540"
                          Padding="8,6"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Silent Device"
                           VerticalAlignment="Center"
                           Width="110" />
                <ComboBox ItemsSource="{Binding SilentDeviceChoices}"
                          SelectedItem="{Binding SelectedSilentDevice}"
                          DisplayMemberPath="FriendlyName"
                          Width="540"
                          Padding="8,6"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="110,0,0,0"
                        Orientation="Horizontal">
                <Button Content="Music Mode"
                        Style="{StaticResource MusicModeButton}"
                        Command="{Binding MusicModeCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTip="Silent Device → Windows-Standard, dann TIDAL exclusive" />
                <Button Content="Normal Mode"
                        Style="{StaticResource NormalModeButton}"
                        Command="{Binding NormalModeCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTip="TIDAL shared, Windows-Standard auf TIDAL Device" />
                <Button Content="Compact Mode"
                        Click="EnterCompactView_Click"
                        Padding="16,8"
                        ToolTip="Fenster verkleinern — Always-On-Top mit Music-Toggle" />
            </StackPanel>
            </Grid>
        </Grid>

        <!-- Compact: transparent shell — only the rounded card is visible -->
        <Grid x:Name="CompactRoot"
              Background="Transparent"
              Visibility="{Binding IsCompactView, Converter={StaticResource BoolToVis}}">
            <Border x:Name="CompactCard"
                    CornerRadius="12"
                    Background="#E6121214"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="12"
                                      ShadowDepth="1"
                                      Opacity="0.5"
                                      Direction="270" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="CompactDragHeader"
                            Grid.Row="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="CompactDragHeader_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="#55FFFFFF"
                                     Margin="2,0" />
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="#55FFFFFF"
                                     Margin="2,0" />
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="#55FFFFFF"
                                     Margin="2,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource CompactRoundButton}"
                                Content="⤢"
                                Click="ExitCompactView_Click"
                                Padding="8,5"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                ToolTip="Erweiterte Ansicht" />

                        <Button Grid.Column="1"
                                Style="{StaticResource CompactMusicButton}"
                                Content="Music"
                                Command="{Binding ToggleModeCommand}"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                ToolTip="Music Mode ein/aus (Normal ↔ Music)" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
