<Application x:Class="TidalAudioSwitcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="MusicModeButton" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMusicModeActive}" Value="True">
                    <Setter Property="Background" Value="#2D6A4F" />
                    <Setter Property="BorderBrush" Value="#40916C" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NormalModeButton" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNormalModeActive}" Value="True">
                    <Setter Property="Background" Value="#3D5A80" />
                    <Setter Property="BorderBrush" Value="#5C7FB8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
